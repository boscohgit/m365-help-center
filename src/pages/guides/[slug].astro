---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Step from "../../components/Step.astro";
import InstructionImages from "../../components/InstructionImages.astro";
import { guides, type Guide } from "../../data/guideContent";

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${guide.title}｜M365 帮助中心`}
  description={guide.description}
>
  <article class="standard-guide" data-pagefind-body>
    <span class="visually-hidden" data-pagefind-meta="keywords" data-pagefind-weight="10">{guide.keywords.join("，")}</span>
    <header class="standard-hero">
      <div class="container standard-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="面包屑">
            <a href={`${base}/`}>首页</a><span>/</span><span data-pagefind-meta="category">{guide.category}</span>
          </nav>
          <p class="eyebrow">{guide.category}</p>
          <h1 data-pagefind-meta="title">{guide.title}</h1>
          <p class="guide-subtitle">{guide.subtitle}</p>
          <p class="guide-lead">{guide.description}</p>
          <div class="meta-row"><span>{guide.duration}</span><span>{guide.device}</span><span>更新于 2026-07-26</span></div>
        </div>
        <div class="completion-card">
          <strong>完成标准</strong>
          <p>{guide.completion}</p>
        </div>
      </div>
    </header>

    <div class="container standard-layout">
      <aside class="standard-toc">
        <strong>本页内容</strong>
        <a href="#prepare">开始前准备</a>
        {guide.sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
      </aside>

      <div class="standard-content">
        <section id="prepare">
          <p class="eyebrow">开始前准备</p>
          <h2>先确认这些条件</h2>
          <div class="prep-grid">
            {guide.prepare.map((item) => <div><b>{item.label}</b><span>{item.text}</span></div>)}
          </div>
          <div class="callout warning"><strong>安全提醒</strong><p>不要在本网站或聊天中提交密码、验证码、二维码、身份证明或包含个人信息的截图。</p></div>
        </section>

        {guide.sections.map((section) => (
          <section id={section.id}>
            <p class="eyebrow">{section.kicker ?? "操作指引"}</p>
            <h2>{section.title}</h2>
            {section.intro && <p class="section-intro">{section.intro}</p>}
            {section.blocks.map((block) => (
              block.type === "step" ? (
                <Step number={block.number} title={block.title}>
                  <p>{block.body}</p>
                  {block.note && <div class="inline-note">{block.note}</div>}
                  {block.warning && <div class="inline-warning">{block.warning}</div>}
                  <InstructionImages images={block.images ?? []} />
                </Step>
              ) : block.type === "point" ? (
                <ul class="point-list">
                  <li>
                    <span>{block.text}</span>
                    <InstructionImages images={block.images ?? []} />
                  </li>
                </ul>
              ) : block.type === "details" ? (
                <details>
                  <summary>{block.title}</summary>
                  <p>{block.body}</p>
                </details>
              ) : (
                <div class:list={["callout", block.tone]}>
                  <strong>{block.title}</strong>
                  <p>{block.body}</p>
                </div>
              )
            ))}
          </section>
        ))}

        <section class="related">
          <p class="eyebrow">继续查找</p>
          <h2>相关帮助</h2>
          <div class="related-grid">
            <a href={`${base}/guides/security-info/`}><strong>添加账号验证方式</strong><span>电话、苹果验证器与安卓验证器</span></a>
            <a href={`${base}/`}><strong>返回帮助中心</strong><span>搜索其他 Microsoft 365 问题</span></a>
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .visually-hidden { position:absolute !important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .standard-hero { padding:54px 0 46px; background:linear-gradient(140deg,#fff 35%,#edf4fa); border-bottom:1px solid var(--line); }
  .standard-hero-grid { display:grid; grid-template-columns:1fr 330px; gap:60px; align-items:end; }
  .breadcrumbs { display:flex; gap:8px; margin-bottom:30px; color:var(--muted); font-size:13px; }
  .breadcrumbs a { text-decoration:none; }.breadcrumbs a:hover { color:var(--blue); }
  .standard-guide h1 { margin:0; color:var(--navy); font-size:clamp(38px,6vw,62px); letter-spacing:-.055em; line-height:1.08; }
  .guide-subtitle { margin:10px 0 0; color:var(--red); font-size:19px; font-weight:750; }
  .guide-lead { max-width:700px; margin:20px 0 0; color:var(--muted); font-size:17px; line-height:1.7; }
  .meta-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }
  .meta-row span { padding:7px 10px; border:1px solid var(--line); border-radius:999px; background:#fff; color:var(--muted); font-size:12px; }
  .completion-card { padding:25px; border-left:4px solid var(--green); border-radius:4px 18px 18px 4px; background:var(--green-soft); }
  .completion-card strong { color:var(--green); }.completion-card p { margin:9px 0 0; line-height:1.7; }
  .standard-layout { display:grid; grid-template-columns:220px minmax(0,760px); gap:70px; align-items:start; padding-top:48px; }
  .standard-toc { position:sticky; top:108px; display:flex; flex-direction:column; gap:6px; padding:18px; max-height:calc(100vh - 130px); overflow:auto; border:1px solid var(--line); border-radius:16px; background:#fff; }
  .standard-toc strong { margin-bottom:8px; color:var(--navy); }
  .standard-toc a { padding:8px 10px; border-radius:9px; color:var(--muted); font-size:13px; text-decoration:none; }
  .standard-toc a:hover { background:var(--blue-soft); color:var(--blue); }
  .standard-content section { scroll-margin-top:100px; padding:28px 0 50px; border-bottom:1px solid var(--line); }
  .standard-content section:first-child { padding-top:0; }
  .standard-content h2 { margin:0 0 20px; color:var(--navy); font-size:clamp(28px,4vw,38px); letter-spacing:-.035em; }
  .section-intro { margin:-5px 0 24px; color:var(--muted); line-height:1.8; }
  .prep-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .prep-grid div { padding:18px; border:1px solid var(--line); border-radius:15px; background:#fff; }
  .prep-grid b,.prep-grid span { display:block; }.prep-grid b { color:var(--red); }.prep-grid span { margin-top:9px; color:var(--muted); font-size:13px; line-height:1.65; }
  .callout { margin:18px 0; padding:18px 20px; border-left:4px solid; border-radius:4px 14px 14px 4px; }
  .callout strong { display:block; }.callout p { margin:5px 0 0; line-height:1.75; }
  .callout.warning { border-color:var(--red); background:var(--red-soft); }.callout.warning strong { color:var(--red); }
  .callout.success { border-color:var(--green); background:var(--green-soft); }.callout.success strong { color:var(--green); }
  .callout.info { border-color:var(--blue); background:var(--blue-soft); }.callout.info strong { color:var(--blue); }
  .step { position:relative; margin:24px 0 36px; padding-left:64px; }
  .step-number { position:absolute; left:0; top:0; display:grid; place-items:center; width:44px; height:44px; border-radius:14px; background:var(--navy); color:#fff; font-size:14px; font-weight:800; }
  .step h3 { margin:0; color:var(--navy); font-size:21px; }.step-body { margin-top:8px; color:#3b4654; line-height:1.9; }
  .step-body p { margin:0; }
  .inline-note,.inline-warning { margin-top:14px; padding:12px 14px; border-radius:11px; font-size:13px; }
  .inline-note { background:var(--blue-soft); color:#315c7e; }.inline-warning { background:var(--red-soft); color:#8e1b2a; }
  .point-list { display:grid; gap:12px; margin:12px 0 0; padding:0; list-style:none; }
  .point-list li { position:relative; padding:16px 18px 16px 46px; border:1px solid var(--line); border-radius:14px; background:#fff; color:#3b4654; line-height:1.75; }
  .point-list li::before { content:"✓"; position:absolute; left:17px; top:16px; display:grid; place-items:center; width:20px; height:20px; border-radius:50%; background:var(--green-soft); color:var(--green); font-size:12px; font-weight:900; }
  .instruction-images { display:grid; grid-template-columns:1fr; gap:14px; margin-top:18px; }
  .instruction-images figure { display:flex; flex-direction:column; margin:0; padding:11px; border:1px solid #d8e4ef; border-radius:15px; background:#f7fafc; }
  .instruction-images .figure-link { display:grid; place-items:center; min-height:160px; overflow:hidden; border-radius:9px; background:#fff; }
  .instruction-images img { display:block; width:100%; height:auto; max-height:410px; object-fit:contain; }
  .instruction-images figcaption { display:flex; flex-direction:column; gap:4px; margin-top:9px; color:var(--muted); font-size:12px; line-height:1.55; text-align:center; }
  .instruction-images figcaption span { color:var(--blue); font-size:11px; }
  .point-list .instruction-images { margin-left:-28px; }
  details { margin:10px 0; border:1px solid var(--line); border-radius:14px; background:#fff; }
  summary { padding:17px 19px; cursor:pointer; color:var(--navy); font-weight:750; }
  details p { margin:0; padding:0 19px 18px; color:var(--muted); line-height:1.75; }
  .related-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .related-grid a { padding:20px; border:1px solid var(--line); border-radius:15px; background:#fff; text-decoration:none; }
  .related-grid strong,.related-grid span { display:block; }.related-grid strong { color:var(--navy); }.related-grid span { margin-top:7px; color:var(--muted); font-size:13px; }
  @media (max-width:900px) {
    .standard-hero-grid { grid-template-columns:1fr; gap:30px; }
    .standard-layout { grid-template-columns:1fr; }
    .standard-toc { position:static; display:grid; grid-template-columns:repeat(3,1fr); max-height:none; }
    .standard-toc strong { grid-column:1/-1; }
  }
  @media (max-width:600px) {
    .standard-hero { padding-top:38px; }
    .prep-grid,.standard-toc,.related-grid { grid-template-columns:1fr; }
    .step { padding-left:0; padding-top:56px; }
  }
</style>
